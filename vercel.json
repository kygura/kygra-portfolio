{
  "buildCommand": "bun run build",
  "functions": {
    "api/github/terminal.ts": { "maxDuration": 60 },
    "api/companion/remark.ts": { "maxDuration": 30 }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(www\\.)?kygra\\.xyz" }],
      "destination": "https://www.nca.ink/$1",
      "permanent": true
    },
    {
      "source": "/writings/the-movement-of-the-world",
      "destination": "/writings/on-the-movements-of-the-world",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/notion", "destination": "/api/notion/webhook" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/notion/sync", "schedule": "0 5 * * *" }]
}
